{
  "name": "bluelock-egoist-life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "preview": "vite preview",
    "assets": "node scripts/fetch-wiki-assets.mjs",
    "voice:export": "tsx scripts/export-voice-script.ts",
